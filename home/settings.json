{
  "cleanupPeriodDays": 60,
  "idleCompaction": false,
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.flow/repos/flow/mods/flow-session:~/.flow/repos/flow/mods/flow-permissions"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "node \"$HOME/.flow/scripts/hooks/file-suggestion.js\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|Bash|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/guard.js\""
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/rule-check.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\""
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\" --wait",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      },
      {
        "matcher": "^Skill$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/overlays.js\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\""
          }
        ]
      },
      {
        "matcher": "^Bash$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/failures.js\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/failures.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/jobs/records-sync.js\" --hook stop",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/jobs/records-sync.js\" --hook end"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/changes.js\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/instructions-loaded.js\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(flow:)?(groundwork|execute|prototype|debug|start)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/check-ticket.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/overlays.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/reminder.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/hooks/session-check.js\""
          }
        ]
      }
    ]
  },
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "feedbackSurveyRate": 0,
  "disableArtifact": true,
  "autoMemoryEnabled": false,
  "autoCompactEnabled": false,
  "respondToBashCommands": false,
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Edit",
      "Edit(//**/.flow/**)",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Monitor"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(util git save *)",
      "Bash(util g save *)",
      "Bash(u git save *)",
      "Bash(u g save *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(cargo publish *)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendUserFile",
      "ShareOnboardingGuide",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "Agent(isolation:worktree)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(mkfs*)",
      "Bash(* --dangerously-skip-permissions *)"
    ],
    "additionalDirectories": [
      "~/.flow"
    ]
  }
}
