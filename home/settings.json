{
  "cleanupPeriodDays": 365,
  "fileSuggestion": {
    "type": "command",
    "command": "node \"$HOME/.flow/scripts/file-suggestion.js\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/guard.js\""
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/rule-check.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\""
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\" --wait",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Edit|Write|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/changes.js\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/instructions-loaded.js\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(flow:)?(groundwork|execute|prototype|debug|start)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/check-ticket.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/reminder.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.flow/scripts/session-check.js\""
          }
        ]
      }
    ]
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "autoMemoryEnabled": false,
  "respondToBashCommands": false,
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash",
      "Edit",
      "WebFetch",
      "WebSearch",
      "mcp__context7__*"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "ListAgents",
      "PushNotification",
      "SendUserFile",
      "ShareOnboardingGuide",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "Agent(isolation:worktree)",
      "Agent(fork)",
      "Bash(flow restore machine:*)",
      "Bash(flow restore project:*)",
      "Bash(flow uninstall:*)",
      "Bash(fw restore machine:*)",
      "Bash(fw restore project:*)",
      "Bash(fw uninstall:*)",
      "Bash(node ~/.flow/scripts/flow/flow.js restore:*)",
      "Bash(node ~/.flow/scripts/flow/flow.js uninstall:*)"
    ]
  }
}
