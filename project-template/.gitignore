tmp/
node_modules

# An external skill lives here as a real folder, copied in and committed. A
# symlink would be stored as this machine's path and load nothing on the next
# machine, so these two lines ignore links and track folders.
.claude/skills/*
!.claude/skills/*/

# .flow/ is Flow's working store — tickets, groundwork, the inbox, the handoff.
# It is committed. A hidden folder invites a blanket ignore, and one stray line
# here loses every ticket the project has.
