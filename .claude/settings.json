{
  "claudeMdExcludes": [
    "**/lab/**/CLAUDE.md",
    "**/repos/**/CLAUDE.md",
    "**/toolbox/**/CLAUDE.md",
    "**/project-template/CLAUDE.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(cargo publish *)"
    ]
  }
}
