{
  "claudeMdExcludes": [
    "**/lab/**/CLAUDE.md",
    "**/repos/**/CLAUDE.md",
    "**/toolbox/**/CLAUDE.md",
    "**/project-template/CLAUDE.md"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(util git save *)",
      "Bash(util g save *)",
      "Bash(u git save *)",
      "Bash(u g save *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(cargo publish *)"
    ]
  }
}
